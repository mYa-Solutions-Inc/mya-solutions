# FILE / ROOT: services/jean-site/.env.example
# DESCRIPTION: Every environment variable jean-site reads, with its default. Copy values
#   into your shell or Cloud Run config; the service does not read .env files itself.
#   Never commit a real API key.

# ---- Provider (swappable by env alone) ----
JEAN_PROVIDER=anthropic                 # anthropic | openai-compatible
JEAN_MODEL=claude-haiku-4-5-20251001    # required for openai-compatible (e.g. llama3.1:8b)
ANTHROPIC_API_KEY=                      # required for anthropic; on Cloud Run comes from Secret Manager
JEAN_TIMEOUT_MS=20000                   # per model call
JEAN_MAX_TOKENS=600

# openai-compatible only (Ollama, llama.cpp server, LM Studio, vLLM, MLX servers)
JEAN_OPENAI_BASE_URL=http://localhost:11434/v1
JEAN_OPENAI_API_KEY=                    # optional bearer token
JEAN_OPENAI_JSON_MODE=0                 # 1 = send response_format {type: json_object}

# ---- Site index ----
JEAN_INDEX_URL=https://myasolutions.org/assets/jean/site-index.json   # empty = bundled file only
JEAN_INDEX_REFRESH_S=600
JEAN_INDEX_FILE=./site-index.json

# ---- Security & cost ----
JEAN_ALLOWED_ORIGINS=https://myasolutions.org,https://www.myasolutions.org
JEAN_DEV=0                              # 1 = also allow http://localhost:* origins
JEAN_RATE_PER_MIN=10                    # per client IP
JEAN_RATE_BURST=5
JEAN_DAILY_LIMIT=2000                   # questions per UTC day, per instance
JEAN_XFF_POSITION=first                 # which X-Forwarded-For entry identifies the client
JEAN_REQUEST_TIMEOUT_MS=30000

# ---- Server ----
PORT=8080
